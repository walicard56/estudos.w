<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: dados do app (salvos pelo WebView) entram no backup do Google e na troca de aparelho. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
